# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db
desktop.ini

# editor
.vscode/
.idea/
*.swp

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright: run artifacts, traces and raw video recordings
/test-results
/playwright-report
/playwright/.cache
/blob-report

# intermediate captures copied into public/ so the hidden showcase route can
# compose them. Regenerated by `npm run fiverr:screenshots`; the final PNG, PDF
# and MP4 deliverables in fiverr-assets/ stay in the repository.
/public/fiverr-captures
